# 학습서버(trainer) 환경 변수 예시. 복사해서 .env로 쓰고, 실제 값은 커밋하지 않는다.

# dev: 로컬 개발 / prod: 학과 서버. prod에서는 TRAINER_API_KEY가 없거나 change-me면 서버가 시작하지 않는다.
TRAINER_ENV=dev

# backend · worker와 학습서버만 아는 키 (7.4 공통 규칙, X-API-Key)
TRAINER_API_KEY=change-me

# 학습서버 레지스트리 DB (8.2.38, reg_ 테이블). 비우면 {DATA_ROOT}/registry/registry.db SQLite 파일.
# 학과 서버에는 DB 서버를 띄우지 않는다(docs/work/design-changes.md 2번). RDS로 옮길 때만 postgresql+psycopg://... 주소를 넣는다.
REGISTRY_DB_URL=

# 데이터 · 모델 · 로그 저장 위치 (학과 서버 /home/t26112/easyq-data, /data 없음 → design-changes 4번)
# 로컬(Windows) 개발에서는 ./data/local 처럼 레포 안 data/ 아래로 둔다(data/는 커밋되지 않음).
DATA_ROOT=/home/t26112/easyq-data

# 바인드 주소: 학과 서버에서는 localhost만 (외부 미개방, EC2는 SSH 터널로만 접근)
TRAINER_HOST=127.0.0.1
TRAINER_PORT=8000

# 판정 추론 프로세스 (학습과 분리, 내부 전용. API 서버의 7.4.26이 호출)
INFERENCE_HOST=127.0.0.1
INFERENCE_PORT=8001
JUDGE_TIMEOUT_MS=800
# 학습 · 평가 · 변환 작업이 쓸 GPU 번호(학과 서버 가이드: 정해진 한 장만), 작업 상태 동기화 주기(초)
GPU_DEVICE=0
JOB_POLL_SECONDS=2

# 검색 모듈 임베딩 (gemini-embedding-2, scripts/search). Google AI Studio에서 발급. 실행: uv run --env-file .env ...
# AI Hub 데이터는 절대 보내지 않는다(3.1.3).
GEMINI_API_KEY=
